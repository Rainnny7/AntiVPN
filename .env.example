# Used by docker-compose.yml, copy to .env

# Required: the password for the MariaDB antivpn user
DATABASE_PASSWORD=change-me

# An API key with every permission, at least 16 characters (e.g. openssl rand -hex 32)
# Leave blank to have a random key generated and logged on first start
ADMIN_API_KEY=

# Leave blank if Redis has no password (the bundled Redis has none)
REDIS_PASSWORD=

# MaxMind GeoLite2, free at https://www.maxmind.com/en/geolite2/signup
# Without these, ASN and location data are unavailable and hosting ASNs can't be detected
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE=

# Optional InfluxDB metrics, leave the url blank to disable
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# Optional Discord webhook, leave blank to disable
# Lookup results (IP, verdict, and request metadata such as a player name) are posted here
DISCORD_WEBHOOK_URL=
# DISCORD_USERNAME=AntiVPN
# DISCORD_MIN_RISK=0
